# SigNoz Cloud: an ingestion key and region (Settings → Ingestion).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.<region>.signoz.cloud:443
OTEL_EXPORTER_OTLP_HEADERS=signoz-ingestion-key=<ingestion key>
# Self-hosted SigNoz instead: point at its collector and drop the header, e.g.
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=demo
