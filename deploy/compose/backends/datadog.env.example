# Datadog agentless OTLP intake: HTTP only (no gRPC), metrics must be delta.
# An API key (Organization settings → API keys) and your site's intake host.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.datadoghq.com
# Other sites: https://otlp.datadoghq.eu, https://otlp.us5.datadoghq.com, ...
OTEL_EXPORTER_OTLP_HEADERS=dd-api-key=<api key>
# Trace metrics aren't computed for directly ingested traces unless asked for:
OTEL_EXPORTER_OTLP_TRACES_HEADERS=dd-api-key=<api key>,compute_stats=true
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=demo
