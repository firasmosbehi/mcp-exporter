# Grafana Cloud: Connections → OpenTelemetry on your stack shows the endpoint
# and instance ID, and generates a token (traces, metrics and logs: write).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# Basic auth with base64 of "<instance id>:<token>"; the raw glc_ token alone gets a 401:
#   printf '%s' '<instance id>:<token>' | base64 | tr -d '\n'
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instance id:token>
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=demo
