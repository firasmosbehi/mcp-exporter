# Honeycomb: an ingest API key for an environment (Environment settings → API keys).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
# EU: OTEL_EXPORTER_OTLP_ENDPOINT=https://api.eu1.honeycomb.io
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=<ingest api key>
# Metrics need a dataset, otherwise they land in "unknown_metrics":
OTEL_EXPORTER_OTLP_METRICS_HEADERS=x-honeycomb-team=<ingest api key>,x-honeycomb-dataset=mcp-metrics
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=demo
